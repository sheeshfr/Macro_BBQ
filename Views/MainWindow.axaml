<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AutoClicker.ViewModels"
        xmlns:models="using:AutoClicker.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="330" d:DesignHeight="110"
        Width="330"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        x:Class="AutoClicker.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/icon.ico"
        Title="Macro BBQ"
        Background="#16171B">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <!-- Default Button: Never steal focus in key-binding utility app -->
        <Style Selector="Button">
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <!-- Main Key Button (Large Prominent Rounded Interactive Keycap) -->
        <Style Selector="Button.main-key-btn">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="#202227"/>
            <Setter Property="BorderBrush" Value="#2E323A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.main-key-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#282B32"/>
            <Setter Property="BorderBrush" Value="#3B404A"/>
        </Style>
        <Style Selector="Button.main-key-btn.running">
            <Setter Property="Background" Value="#052E16"/>
            <Setter Property="BorderBrush" Value="#22C55E"/>
        </Style>
        <Style Selector="Button.main-key-btn.recording">
            <Setter Property="Background" Value="#3E1F07"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
        </Style>
        <Style Selector="Button.main-key-btn.recording:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4C260A"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
        </Style>
        <Style Selector="Button.main-key-btn TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4ADE80"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.main-key-btn.recording TextBlock">
            <Setter Property="Foreground" Value="#FBBF24"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Compact Key Button (Used in Secondary Button inside Modifier) -->
        <Style Selector="Button.key-btn">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="#202227"/>
            <Setter Property="BorderBrush" Value="#2E323A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.key-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#282B32"/>
            <Setter Property="BorderBrush" Value="#3B404A"/>
        </Style>
        <Style Selector="Button.key-btn.running">
            <Setter Property="Background" Value="#052E16"/>
            <Setter Property="BorderBrush" Value="#22C55E"/>
        </Style>
        <Style Selector="Button.key-btn.recording">
            <Setter Property="Background" Value="#3E1F07"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
        </Style>
        <Style Selector="Button.key-btn.recording:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4C260A"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
        </Style>
        <Style Selector="Button.key-btn TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4ADE80"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.key-btn.recording TextBlock">
            <Setter Property="Foreground" Value="#FBBF24"/>
        </Style>

        <!-- Pill Reset Button (Centered below F6 and Primary Click) -->
        <Style Selector="Button.pill-reset-btn">
            <Setter Property="Background" Value="#202227"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="BorderBrush" Value="#2E323A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,1"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.pill-reset-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2B2F38"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3B404A"/>
        </Style>

        <!-- Secondary Action Button (Reset inside modifier - Compact Rounded) -->
        <Style Selector="Button.act-btn">
            <Setter Property="Background" Value="#202227"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="BorderBrush" Value="#2E323A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.act-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2B2F38"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Modifier Action Button (Compact Rounded with Active Glow) -->
        <Style Selector="Button.mod-btn">
            <Setter Property="Background" Value="#202227"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="BorderBrush" Value="#2E323A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.mod-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2B2F38"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3B404A"/>
        </Style>
        <Style Selector="Button.mod-btn.enabled">
            <Setter Property="Background" Value="#0A2A1A"/>
            <Setter Property="Foreground" Value="#4ADE80"/>
            <Setter Property="BorderBrush" Value="#16A34A"/>
        </Style>
        <Style Selector="Button.mod-btn.enabled:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0F3823"/>
            <Setter Property="Foreground" Value="#86EFAC"/>
            <Setter Property="BorderBrush" Value="#22C55E"/>
        </Style>
        <Style Selector="Button.mod-btn.open">
            <Setter Property="BorderBrush" Value="#4ADE80"/>
        </Style>

        <!-- Settings Gear Button (Placed to the right of the Profile Selector) -->
        <Style Selector="Button.gear-btn">
            <Setter Property="Background" Value="#202227"/>
            <Setter Property="BorderBrush" Value="#2E323A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.gear-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2B2F38"/>
            <Setter Property="BorderBrush" Value="#4ADE80"/>
        </Style>
        <Style Selector="Button.gear-btn.active">
            <Setter Property="Background" Value="#2B2F38"/>
            <Setter Property="BorderBrush" Value="#4ADE80"/>
        </Style>
        <Style Selector="Button.gear-btn.active PathIcon">
            <Setter Property="Foreground" Value="#4ADE80"/>
        </Style>

        <!-- NumericUpDown Rounded Styling -->
        <Style Selector="NumericUpDown">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#202227"/>
            <Setter Property="BorderBrush" Value="#2E323A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="NumericUpDown.main-interval">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#202227"/>
            <Setter Property="BorderBrush" Value="#2E323A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="NumericUpDown.main-interval /template/ TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Segmented Mode Buttons (Compact Rounded) -->
        <Style Selector="Button.seg-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,2"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.seg-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#262931"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
        </Style>
        <Style Selector="Button.seg-btn.active">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.seg-btn.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22C55E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Compact Settings CheckBox & RadioButton -->
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Padding" Value="5,0,0,0"/>
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Padding" Value="5,0,0,0"/>
        </Style>

        <!-- Profile Selector Button (Top Center Compact Rounded Pill) -->
        <Style Selector="Button.profile-btn">
            <Setter Property="Background" Value="#202227"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="BorderBrush" Value="#2E323A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.profile-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#282B32"/>
            <Setter Property="BorderBrush" Value="#3B404A"/>
        </Style>
        <Style Selector="Button.profile-btn.open">
            <Setter Property="BorderBrush" Value="#4ADE80"/>
        </Style>

        <!-- Profile Item Card Styling -->
        <Style Selector="Border.profile-item">
            <Setter Property="Background" Value="#181A20"/>
            <Setter Property="BorderBrush" Value="#2D3039"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Border.profile-item.active">
            <Setter Property="Background" Value="#0A2A1A"/>
            <Setter Property="BorderBrush" Value="#16A34A"/>
        </Style>

        <!-- Clean FlyoutPresenter: Removes default outer grey frame and padding -->
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </Window.Styles>

    <!-- Root Panel containing Main Controls and aligned Popup -->
    <Panel x:Name="RootPanel">
        <StackPanel Margin="14,12,14,12" Spacing="0">

            <!-- Row 0: Top Bar with Status (Left) and Profile Selector (Center) -->
            <Grid ColumnDefinitions="1*,Auto,1*" Margin="0,0,0,10">
                <!-- Status indicator if active -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Ellipse Width="6" Height="6" Fill="#22C55E" IsVisible="{Binding IsActiveRunning}"/>
                    <TextBlock Text="ON" FontSize="9.5" FontWeight="Bold" Foreground="#22C55E" IsVisible="{Binding IsActiveRunning}"/>
                </StackPanel>

                <!-- Profile Selector Button (Top Center Compact Rounded Pill) -->
                <Button Grid.Column="1"
                        Classes="profile-btn"
                        Classes.open="{Binding IsProfilesPopupOpen}"
                        Command="{Binding ToggleProfilesPopupCommand}"
                        HorizontalAlignment="Center"
                        ToolTip.Tip="Manage profiles (save/load game configurations)">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="PROFILE:" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ActiveProfileName}" FontSize="11" FontWeight="Bold" Foreground="#4ADE80" VerticalAlignment="Center"/>
                        <TextBlock Text="▼" FontSize="8.5" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Row 1: Left Column (Trigger) & Right Column (Interval) -->
            <Grid ColumnDefinitions="*,*" Margin="0,0,0,8">
                <!-- Left Column: TRIGGER -->
                <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="TRIGGER" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                    <Button x:Name="TriggerKeyButton"
                            Classes="main-key-btn"
                            Classes.running="{Binding IsActiveRunning}"
                            Classes.recording="{Binding IsRecordingHotkey}"
                            Command="{Binding ToggleRecordingHotkeyCommand}"
                            ToolTip.Tip="Trigger Hotkey: Click to bind • Right-click to reset (F6)">
                        <TextBlock Text="{Binding KeyButtonText}"/>
                    </Button>
                </StackPanel>

                <!-- Right Column: INTERVAL (ms) -->
                <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="INTERVAL (ms)" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                    <NumericUpDown Classes="main-interval"
                                   Value="{Binding IntervalMs}"
                                   Minimum="1" Maximum="3600000"
                                   Increment="10"
                                   FormatString="0"
                                   ShowButtonSpinner="False"
                                   ToolTip.Tip="Click interval in milliseconds"/>
                </StackPanel>
            </Grid>

            <!-- Row 2: Mode Switch (Toggle | Hold) sits between Trigger/Interval and Primary -->
            <Border Background="#181A20"
                    BorderBrush="#2D3039"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="2"
                    Height="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,0,0,8">
                <Grid ColumnDefinitions="Auto,Auto">
                    <Button Grid.Column="0"
                            Classes="seg-btn"
                            Classes.active="{Binding IsToggleMode}"
                            Command="{Binding SelectToggleModeCommand}"
                            Content="Toggle"/>
                    <Button Grid.Column="1"
                            Classes="seg-btn"
                            Classes.active="{Binding IsHoldMode}"
                            Command="{Binding SelectHoldModeCommand}"
                            Content="Hold"/>
                </Grid>
            </Border>

            <!-- Row 3: PRIMARY Section (Centered) -->
            <StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="PRIMARY" FontSize="10" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Center"/>
                <Button x:Name="PrimaryKeyButton"
                        Classes="main-key-btn"
                        Classes.recording="{Binding IsRecordingPrimary}"
                        Command="{Binding ToggleRecordingPrimaryCommand}"
                        MinWidth="120"
                        ToolTip.Tip="Primary Click: Click to bind • Right-click to reset (M1 Left)">
                    <TextBlock Text="{Binding PrimaryKeyButtonText}" FontSize="15"/>
                </Button>
            </StackPanel>

            <!-- Row 4: Enable Modifier & Settings (Settings on far right) -->
            <Grid ColumnDefinitions="*,Auto" Margin="6,0,6,0">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsModifierEnabled}"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Enable extra secondary button action (e.g. Aim ADS + Fire or Dual Spam)">
                    <TextBlock Text="Enable Modifier" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </CheckBox>

                <Button Grid.Column="1"
                        Classes="gear-btn"
                        Classes.active="{Binding IsSettingsOpen}"
                        Command="{Binding ToggleSettingsCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Settings">
                    <PathIcon Width="13" Height="13" Foreground="#9CA3AF"
                              Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
                </Button>
            </Grid>

            <!-- Row 4: Collapsible Modifier Container (Appears when IsModifierEnabled is True) -->
            <Border IsVisible="{Binding IsModifierEnabled}"
                    Background="#181A20"
                    BorderBrush="#2D3039"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,8,0,0">
                <StackPanel Spacing="7">
                    <!-- Secondary Button (Interactive keycap button + Reset) -->
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="SECONDARY BUTTON" FontSize="9.5" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Classes="key-btn"
                                    Classes.recording="{Binding IsRecordingModifier}"
                                    Command="{Binding ToggleRecordingModifierCommand}"
                                    Height="24" MinWidth="80"
                                    ToolTip.Tip="Click to record secondary button (any mouse button or keyboard key) • Esc cancels">
                                <TextBlock Text="{Binding ModifierKeyButtonText}" FontSize="11"/>
                            </Button>
                            <Button Command="{Binding ResetModifierButtonCommand}"
                                    Classes="act-btn"
                                    Content="Reset"
                                    Height="24"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Reset secondary button to Right Click (M2)"/>
                        </StackPanel>
                    </Grid>

                    <!-- Behavior (Hold vs Spam) -->
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="ACTION" FontSize="9.5" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <RadioButton Content="Hold" IsChecked="{Binding IsModHoldAction}" GroupName="ModActionGroup" Foreground="#E5E7EB" ToolTip.Tip="Hold 2nd button down continuously while primary spams"/>
                            <RadioButton Content="Spam" IsChecked="{Binding IsModSpamAction}" GroupName="ModActionGroup" Foreground="#E5E7EB" ToolTip.Tip="Spam both buttons together"/>
                        </StackPanel>
                    </Grid>

                    <!-- Trigger Sequence / Order -->
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="FIRST TRIGGER" FontSize="9.5" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <RadioButton Content="Secondary 1st" IsChecked="{Binding IsModFirstOrder}" GroupName="ModOrderGroup" Foreground="#E5E7EB" ToolTip.Tip="Press Secondary button down first (e.g. Aim ADS), then start primary spam"/>
                            <RadioButton Content="Primary 1st" IsChecked="{Binding IsPrimaryFirstOrder}" GroupName="ModOrderGroup" Foreground="#E5E7EB" ToolTip.Tip="Press Primary button first, then trigger secondary"/>
                        </StackPanel>
                    </Grid>

                    <!-- Pre-Delay -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="PRE-DELAY" FontSize="9.5" FontWeight="Bold" Foreground="#9CA3AF"/>
                            <TextBlock Text="Hold time before spam begins" FontSize="9" Foreground="#6B7280"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <NumericUpDown Value="{Binding ModifierDelayMs}"
                                           Minimum="1" Maximum="1000"
                                           Increment="1"
                                           FormatString="0"
                                           ShowButtonSpinner="False"
                                           CornerRadius="6"
                                           Height="24"
                                           Width="50"
                                           FontSize="11"
                                           VerticalContentAlignment="Center"/>
                            <TextBlock Text="ms" VerticalAlignment="Center" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Settings Popup: Appears perfectly in line, underneath the main window width -->
        <Popup x:Name="SettingsPopup"
               IsOpen="{Binding IsSettingsOpen, Mode=TwoWay}"
               PlacementTarget="{Binding #RootPanel}"
               Placement="BottomEdgeAlignedLeft"
               HorizontalOffset="0"
               VerticalOffset="4"
               IsLightDismissEnabled="True">
            <Border Background="#1C1E24"
                    BorderBrush="#2D3039"
                    BorderThickness="1"
                    CornerRadius="10"
                    Width="330"
                    Padding="14,10">
                <StackPanel Spacing="7">
                    <!-- Row 1: General &amp; Safety Options -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="GENERAL &amp; SAFETY" FontSize="9.5" FontWeight="Bold" Foreground="#9CA3AF"/>
                        <CheckBox IsChecked="{Binding StopOnEscape}" Content="Emergency stop on Escape" Foreground="#E5E7EB"/>
                        <CheckBox IsChecked="{Binding CloseToTray}" Content="Close to System Tray" Foreground="#E5E7EB"/>
                    </StackPanel>

                    <Separator Background="#262932" Height="1" Margin="0,1"/>

                    <!-- Row 3: Condensed Attribution (Single clean line) -->
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,1,0,0">
                        <TextBlock Text="Vibe Coded by SheeshFr" FontSize="9.5" Foreground="#6B7280"/>
                        <TextBlock Text="•" FontSize="9.5" Foreground="#374151"/>
                        <TextBlock Text="made for shooter games" FontSize="9.5" Foreground="#4B5563"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>


        <!-- Profiles Slot Popup: Appears right underneath main window -->
        <Popup x:Name="ProfilesPopup"
               IsOpen="{Binding IsProfilesPopupOpen, Mode=TwoWay}"
               PlacementTarget="{Binding #RootPanel}"
               Placement="BottomEdgeAlignedLeft"
               HorizontalOffset="0"
               VerticalOffset="4"
               IsLightDismissEnabled="True">
            <Border Background="#1C1E24"
                    BorderBrush="#2D3039"
                    BorderThickness="1"
                    CornerRadius="10"
                    Width="330"
                    Padding="14,10">
                <StackPanel Spacing="8">
                    <!-- Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="PROFILES" FontSize="9.5" FontWeight="Bold" Foreground="#4ADE80"/>
                            <TextBlock Text="Save &amp; load per-game configurations" FontSize="9" Foreground="#9CA3AF"/>
                        </StackPanel>
                    </Grid>

                    <Separator Background="#262932" Height="1" Margin="0,1"/>

                    <!-- Create / Rename input row -->
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding NewProfileName, Mode=TwoWay}"
                                 Watermark="Profile name (e.g. Apex, CoD)..."
                                 Height="26"
                                 FontSize="11"
                                 CornerRadius="6"
                                 Background="#202227"
                                 BorderBrush="#2E323A"
                                 Padding="8,4"
                                 VerticalContentAlignment="Center"
                                 KeyDown="OnNewProfileTextBoxKeyDown"
                                 Margin="0,0,6,0"/>
                        <Button Grid.Column="1"
                                Classes="act-btn"
                                Command="{Binding CreateProfileCommand}"
                                Content="+ Add"
                                Height="26"
                                Margin="0,0,4,0"
                                ToolTip.Tip="Save current settings as a new profile"/>
                        <Button Grid.Column="2"
                                Classes="act-btn"
                                Command="{Binding RenameActiveProfileCommand}"
                                Content="Rename"
                                Height="26"
                                ToolTip.Tip="Rename active profile to entered text"/>
                    </Grid>

                    <!-- Profiles List -->
                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Profile">
                                    <Border Classes="profile-item"
                                            Classes.active="{Binding IsActive}"
                                            Padding="8,6"
                                            Margin="0,0,0,4">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <Button Grid.Column="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectProfileCommand}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"
                                                    ToolTip.Tip="Click to load this profile">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#E5E7EB"/>
                                                    <TextBlock Text="{Binding SummaryText}" FontSize="9" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Active Badge -->
                                            <Border Grid.Column="1"
                                                    Background="#052E16"
                                                    BorderBrush="#22C55E"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    Margin="4,0"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsActive}">
                                                <TextBlock Text="ACTIVE" FontSize="8.5" FontWeight="Bold" Foreground="#4ADE80"/>
                                            </Border>

                                            <!-- Delete Button -->
                                            <Button Grid.Column="2"
                                                    Classes="act-btn"
                                                    Padding="6,1"
                                                    Height="20"
                                                    FontSize="9"
                                                    Content="✕"
                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteProfileCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding CanDelete}"
                                                    ToolTip.Tip="Delete this profile"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>
    </Panel>
</Window>

